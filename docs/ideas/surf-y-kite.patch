index 0000000..0f78f20
--- /dev/null
+++ b/src/lib/actividades.ts
@@ -0,0 +1,73 @@
+// Lógica pura (cliente y servidor) del modo "Actividades" del mapa: si hoy sirve cada playa para surf o
+// kite/windsurf. No hace pedidos: usa el viento de MET Norway y las olas de WaveWatch III que ya trae el clima
+// de cada playa (ver `weather.ts` y `mar.ts`), más su orientación. Los umbrales son una estimación propia,
+// a calibrar con gente que practique en Montevideo; no son datos oficiales (ver /terminos#actividades).
+// Vigencia: quien la usa no evalúa si el pronóstico tiene más de 3 horas (`vientoVigente`, Viento.tsx).
+
+import { exposicion } from "./recomendacion";
+import type { Weather } from "./weather";
+
+export type NivelActividad = "ideal" | "posible" | "no" | "peligro";
+
+export type Evaluacion = {
+  nivel: NivelActividad;
+  motivo: string;
+  datos: string; // para la etiqueta del mapa: "1,2 m · 8 s"
+};
+
+export const NIVEL_ACTIVIDAD: Record<NivelActividad, { color: string; label: string; orden: number }> = {
+  ideal: { color: "#16a34a", label: "Ideal", orden: 0 },
+  posible: { color: "#eab308", label: "Posible", orden: 1 },
+  no: { color: "#94a3b8", label: "No", orden: 2 },
+  peligro: { color: "#ef4444", label: "Peligro", orden: 3 },
+};
+
+const uno = (v: number) => v.toFixed(1).replace(".", ",");
+
+/** Noche o tormenta: no se recomienda ninguna actividad, con cualquier viento u ola. */
+function impedimento(c: Weather): Pick<Evaluacion, "nivel" | "motivo"> | null {
+  if (c.weatherCode >= 95) return { nivel: "peligro", motivo: "Tormenta" };
+  if (!c.isDay) return { nivel: "no", motivo: "Es de noche" };
+  return null;
+}
+
+export function evaluarSurf(orientacion: number, c: Weather): Evaluacion {
+  const h = c.waveHeight;
+  const periodo = c.wavePeriod;
+  const datos = h == null ? "sin datos" : `${uno(h)} m${periodo == null ? "" : ` · ${Math.round(periodo)} s`}`;
+  const no = (motivo: string): Evaluacion => ({ nivel: "no", motivo, datos });
+
+  const imp = impedimento(c);
+  if (imp) return { ...imp, datos };
+  if (h == null || periodo == null) return no("Sin datos de olas");
+  if (h < 0.5) return no(`Olas muy chicas (${uno(h)} m)`);
+  if (h > 2.5) return { nivel: "peligro", motivo: `Olas muy grandes (${uno(h)} m)`, datos };
+  if (periodo < 4) return no(`Olas muy seguidas (${Math.round(periodo)} s)`);
+  if (c.waveDirection != null && exposicion(orientacion, c.waveDirection).tipo === "tierra") return no("Las olas no entran a esta playa");
+
+  const viento = exposicion(orientacion, c.windDirection);
+  if (viento.tipo === "frente" && c.windSpeed >= 25) return no(`Viento de frente fuerte (${Math.round(c.windSpeed)} km/h)`);
+
+  const vientoBueno = viento.tipo === "tierra" || c.windSpeed < 12;
+  if (periodo >= 7 && vientoBueno && h <= 2) return { nivel: "ideal", motivo: `Olas ordenadas, de ${Math.round(periodo)} s, y viento a favor`, datos };
+  if (periodo < 7) return { nivel: "posible", motivo: `Olas cortas (${Math.round(periodo)} s), más desordenadas`, datos };
+  return { nivel: "posible", motivo: "Hay olas, pero el viento no ayuda", datos };
+}
+
+export function evaluarKite(orientacion: number, c: Weather): Evaluacion {
+  const kmh = Math.round(c.windSpeed);
+  const datos = `${kmh} km/h`;
+
+  const imp = impedimento(c);
+  if (imp) return { ...imp, datos };
+  if (c.windSpeed < 20) return { nivel: "no", motivo: `Poco viento (${kmh} km/h)`, datos };
+  if (c.windSpeed > 45) return { nivel: "peligro", motivo: `Demasiado viento (${kmh} km/h)`, datos };
+
+  const viento = exposicion(orientacion, c.windDirection);
+  // Va antes que "ideal": el viento hacia el agua aleja de la costa, por buena que sea la velocidad.
+  // Más estricto que `tipo === "tierra"`: un lateral que ya tira un poco hacia el agua (más de 10°) también aleja.
+  if (viento.factor < -0.17) return { nivel: "peligro", motivo: "El viento va hacia el agua y te aleja de la costa", datos };
+  if (viento.factor > 0.85) return { nivel: "posible", motivo: "Viento de frente: cuesta salir", datos };
+  if (c.windSpeed > 40) return { nivel: "posible", motivo: `Mucho viento (${kmh} km/h), para quien tiene experiencia`, datos };
+  return { nivel: "ideal", motivo: `Viento lateral de ${kmh} km/h`, datos };
+}
