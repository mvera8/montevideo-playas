+  // Degradé: abajo agua, arriba espuma del color del nivel.
+  const pos = olaPieza.attributes.position;
+  const tinte = olaPieza.attributes.aTinte;
+  for (let i = 0; i < pos.count; i++) tinte.setX(i, Math.min(Math.max((pos.getY(i) - 2.4) / 1.1, 0), 1));
