+
+// Kite con su navegante: la vela es una medialuna ancha en X, a ~12 m, unida con dos líneas a la persona en
+// el origen. El viento va hacia +Z (la capa la gira): en el shader la vela se inclina hacia ahí.
+export function crearGeometriaKite(): BufferGeometry {
+  const puntos: Vector2[] = [];
