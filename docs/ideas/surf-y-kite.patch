@@ -0,0 +1,173 @@
+"use client";
+
+import { useEffect, useRef, useState } from "react";
+import { Waves, Wind } from "@phosphor-icons/react/dist/ssr";
+import type { Map as MapLibreMap } from "maplibre-gl";
+import { NIVEL_ACTIVIDAD, evaluarKite, evaluarSurf, type Evaluacion } from "@/lib/actividades";
+import type { Playa } from "@/lib/playas";
+import type { Actividad, ActividadMapa, PuntoActividad } from "./capa-casillas";
+import { vientoVigente } from "./Viento";
+
+// Modo "Actividades" del mapa: por cada playa, una ola con surfista o un kite 3D (los dibuja `CapaCasillas`,
+// un draw call por actividad) con el color de la condición de hoy, una etiqueta y una lista con el motivo.
+// Usa el clima que ya trae cada playa: no hace pedidos nuevos. Las reglas están en `src/lib/actividades.ts`.
+
+const ACTIVIDADES: Record<Actividad, { label: string; Icono: typeof Waves }> = {
+  surf: { label: "Surf", Icono: Waves },
+  kite: { label: "Kite / windsurf", Icono: Wind },
+};
+
+const evaluar = (a: Actividad, p: Playa) => (a === "surf" ? evaluarSurf : evaluarKite)(p.orientacion, p.clima!);
+const conClima = (playas: Playa[], ahora = Date.now()) => playas.filter((p) => p.clima && vientoVigente(p.clima.time, ahora));
+const etiqueta = (e: Evaluacion) => `${NIVEL_ACTIVIDAD[e.nivel].label} · ${e.datos}`;
+
+/** Lo que dibuja la capa 3D: solo playas con clima vigente. */
+export function actividadesMapa(playas: Playa[], ahora = Date.now()): Record<Actividad, ActividadMapa[]> {
+  const vigentes = conClima(playas, ahora);
+  const items = (a: Actividad, rumbo: (p: Playa) => number) =>
+    vigentes.map((p) => {
+      const e = evaluar(a, p);
+      return {
+        lng: p.lon,
+        lat: p.lat,
+        orientacion: p.orientacion,
+        rumbo: rumbo(p),
+        color: NIVEL_ACTIVIDAD[e.nivel].color,
+        viva: e.nivel === "ideal" || e.nivel === "posible",
+        etiqueta: etiqueta(e),
+      };
+    });
+  return {
+    surf: items("surf", (p) => p.orientacion + 180), // la ola va hacia la costa
+    kite: items("kite", (p) => p.clima!.windDirection + 180), // el viento tira hacia donde sopla
+  };
+}
+
+/** Capa de etiquetas (oculta hasta que se elige una actividad). La ubica la capa 3D: ver `onActividadMovida`. */
+export function agregarCapaActividad(map: MapLibreMap) {
+  map.addSource("actividad", { type: "geojson", data: { type: "FeatureCollection", features: [] } });
+  map.addLayer({
+    id: "actividad",
+    type: "symbol",
+    source: "actividad",
+    layout: {
+      visibility: "none",
+      "text-field": ["get", "etiqueta"],
+      "text-font": ["Noto Sans Bold"],
+      "text-size": ["interpolate", ["linear"], ["zoom"], 10, 10, 15, 13],
+    },
+    paint: { "text-color": "#0f3a52", "text-halo-color": "#ffffff", "text-halo-width": 1.6 },
+  });
+}
+
+export function etiquetasActividad(puntos: PuntoActividad[]): GeoJSON.FeatureCollection {
+  return {
+    type: "FeatureCollection",
+    features: puntos.map((p) => ({
+      type: "Feature",
+      geometry: { type: "Point", coordinates: p.lngLat },
+      properties: { etiqueta: p.etiqueta },
+    })),
+  };
+}
+
+/** Botón con desplegable para elegir la actividad (arriba a la derecha, junto a Viento). */
+export function BotonActividades({ actividad, onCambiar }: { actividad: Actividad | null; onCambiar: (a: Actividad | null) => void }) {
+  const [abierto, setAbierto] = useState(false);
+  const ref = useRef<HTMLDivElement>(null);
+
+  // Cerrar al tocar afuera o con Escape.
+  useEffect(() => {
+    if (!abierto) return;
+    const fuera = (e: PointerEvent) => !ref.current?.contains(e.target as Node) && setAbierto(false);
+    const esc = (e: KeyboardEvent) => e.key === "Escape" && setAbierto(false);
+    document.addEventListener("pointerdown", fuera);
+    document.addEventListener("keydown", esc);
+    return () => {
+      document.removeEventListener("pointerdown", fuera);
+      document.removeEventListener("keydown", esc);
+    };
+  }, [abierto]);
+
+  return (
+    <div ref={ref} className="relative">
+      <button
+        onClick={() => setAbierto((v) => !v)}
+        aria-expanded={abierto}
+        aria-haspopup="menu"
+        title="Actividades"
+        className={`flex h-10 w-10 items-center justify-center gap-2 rounded-xl text-sm font-medium shadow-lg ring-1 backdrop-blur md:h-12 md:w-auto md:rounded-2xl md:px-4 ${
+          actividad
+            ? "bg-sky-700 text-white ring-sky-800/20"
+            : "bg-white/95 text-slate-700 ring-black/5 hover:text-slate-900 dark:bg-oscuro-1/95 dark:text-neutral-200 dark:ring-white/10"
+        }`}
+      >
+        <Waves className="h-5 w-5" weight={actividad ? "bold" : "regular"} aria-hidden />
+        <span className="max-md:sr-only">Actividades</span>
+      </button>
+
+      {abierto && (
+        <div
+          role="menu"
+          className="absolute right-0 top-full z-30 mt-2 w-52 origin-top-right animate-[aparecer_150ms_ease-out] rounded-2xl bg-white/95 p-2 shadow-xl ring-1 ring-black/5 backdrop-blur motion-reduce:animate-none dark:bg-oscuro-1/95 dark:text-neutral-200 dark:ring-white/10"
+        >
+          {(Object.keys(ACTIVIDADES) as Actividad[]).map((a) => {
+            const { label, Icono } = ACTIVIDADES[a];
+            const activa = actividad === a;
+            return (
+              <button
+                key={a}
+                role="menuitemradio"
+                aria-checked={activa}
+                onClick={() => {
+                  onCambiar(activa ? null : a);
+                  setAbierto(false);
+                }}
+                className={`flex w-full items-center gap-3 rounded-xl px-3 py-2 text-left text-sm ${
+                  activa ? "bg-sky-50 font-medium text-sky-900 dark:bg-oscuro-3 dark:text-white" : "hover:bg-slate-50 dark:hover:bg-oscuro-3"
+                }`}
+              >
+                <Icono className="h-5 w-5" aria-hidden />
+                {label}
+              </button>
+            );
+          })}
+        </div>
+      )}
+    </div>
+  );
+}
+
+/** Playas de mejor a peor, con el motivo; avisa si no hay datos recientes. */
+export function LeyendaActividad({ actividad, playas }: { actividad: Actividad; playas: Playa[] }) {
+  const lista = conClima(playas)
+    .map((p) => ({ slug: p.slug, nombre: p.nombre, e: evaluar(actividad, p) }))
+    .sort((a, b) => NIVEL_ACTIVIDAD[a.e.nivel].orden - NIVEL_ACTIVIDAD[b.e.nivel].orden);
+
+  return (
+    <div className="pointer-events-auto w-64 animate-[aparecer_150ms_ease-out] rounded-2xl bg-white/95 px-3 py-2.5 text-xs text-slate-600 shadow-lg ring-1 ring-black/5 backdrop-blur motion-reduce:animate-none dark:bg-oscuro-1/95 dark:text-neutral-300 dark:ring-white/10">
+      {lista.length ? (
+        <>
+          <p className="font-medium text-slate-900 dark:text-white">{ACTIVIDADES[actividad].label} ahora</p>
+          <ul className="mt-2 max-h-[32vh] space-y-1.5 max-md:max-h-[20vh] overflow-y-auto">
+            {lista.map(({ slug, nombre, e }) => (
+              <li key={slug} className="flex gap-2">
+                <span className="mt-1 h-2 w-2 shrink-0 rounded-full" style={{ background: NIVEL_ACTIVIDAD[e.nivel].color }} aria-hidden />
+                <span>
+                  <span className="font-medium text-slate-800 dark:text-neutral-100">{nombre}</span>
+                  <span className="sr-only"> ({NIVEL_ACTIVIDAD[e.nivel].label})</span>
+                  <span className="block text-slate-500 dark:text-neutral-400">{e.motivo}</span>
+                </span>
+              </li>
+            ))}
+          </ul>
+          <p className="mt-2 border-t border-slate-100 pt-2 text-slate-400 dark:border-oscuro-3">
+            Cálculo propio y orientativo, con pronósticos de MET Norway y NOAA. Mirá el lugar y hacé caso a la bandera.
+          </p>
+        </>
+      ) : (
+        <p className="font-medium text-slate-900 dark:text-white">Sin datos recientes para {ACTIVIDADES[actividad].label.toLowerCase()}</p>
+      )}
+    </div>
+  );
+}
