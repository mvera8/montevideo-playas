+  const arco = (t: number) => (Math.PI / 12) * (1 - t) + ((11 * Math.PI) / 12) * t;
+  for (let i = 0; i <= pasos; i++) {
+    const a = arco(i / pasos);
+    puntos.push(new Vector2(Math.cos(a) * 7, 6 + Math.sin(a) * 7));
+  }
+  for (let i = pasos; i >= 0; i--) {
+    const t = i / pasos;
+    const a = arco(t);
+    const r = 7 - 1.7 * Math.sin(t * Math.PI);
+    puntos.push(new Vector2(Math.cos(a) * r, 6 + Math.sin(a) * r));
+  }
