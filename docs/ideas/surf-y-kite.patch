+  perfil.bezierCurveTo(-4, 0.3, -2, 4.8, 0.8, 5);
+  perfil.quadraticCurveTo(2.6, 5.1, 3.6, 3.7);
+  perfil.quadraticCurveTo(2.2, 3.7, 2.1, 2.3);
+  perfil.quadraticCurveTo(2.2, 0.8, 5.2, 0);
+  perfil.closePath();
+  const ANCHO_OLA = 10;
+  const ola = new ExtrudeGeometry(perfil, { depth: ANCHO_OLA, steps: 12, bevelEnabled: false, curveSegments: 10 });
+  ola.translate(0, 0, -ANCHO_OLA / 2);
+  // Se afina hacia los costados para que no parezca una caja.
+  const vertices = ola.attributes.position;
+  for (let i = 0; i < vertices.count; i++) {
+    const borde = 1 - ((vertices.getZ(i) / (ANCHO_OLA / 2)) ** 4);
+    vertices.setY(i, vertices.getY(i) * 0.8 * borde);
+    vertices.setX(i, vertices.getX(i) * (0.55 + 0.45 * borde));
+  }
