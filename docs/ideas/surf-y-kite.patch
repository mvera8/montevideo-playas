+// Modelos del modo "Actividades" (Actividades.tsx). Cada pieza lleva su color fijo (aFijo), cuánto toma del
+// color de la instancia, que es el nivel de la condición (aTinte), y si es la parte móvil (aParte). Se dibujan
+// con InstancedMesh y se animan en el vertex shader, como las flechas de viento.
+function pieza(geo: BufferGeometry, color: string, tinte = 0, parte = 1): BufferGeometry {
+  const g = geo.index ? geo.toNonIndexed() : geo;
+  g.deleteAttribute("uv");
+  g.computeVertexNormals();
+  const n = g.attributes.position.count;
+  const c = new Color(color);
+  const fijo = new Float32Array(n * 3);
+  for (let i = 0; i < n; i++) c.toArray(fijo, i * 3);
+  g.setAttribute("aFijo", new BufferAttribute(fijo, 3));
+  g.setAttribute("aTinte", new BufferAttribute(new Float32Array(n).fill(tinte), 1));
+  g.setAttribute("aParte", new BufferAttribute(new Float32Array(n).fill(parte), 1));
+  return g;
