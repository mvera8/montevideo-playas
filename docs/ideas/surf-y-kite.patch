+  const punta = 7 * Math.cos(Math.PI / 12);
+  const altoPunta = 6 + 7 * Math.sin(Math.PI / 12);
+  const manos = new Vector3(0, 1.4, 0);
+  const partes = [
+    pieza(vela, "#ffffff", 1, 2),
+    pieza(linea(new Vector3(-punta, altoPunta, 0), manos), "#f8fafc", 0, 2),
+    pieza(linea(new Vector3(punta, altoPunta, 0), manos), "#f8fafc", 0, 2),
+    ...persona(2.2, "#ffffff", 0.75),
+  ];
