+// Persona parada sobre una tabla larga en Z, con los pies en el origen (y un poco de lado, como al surfear).
+function persona(tablaLargo: number, tablaColor: string, tinte: number): BufferGeometry[] {
+  const contorno = new Shape();
+  contorno.moveTo(-0.32, -tablaLargo / 2 + 0.3);
+  contorno.quadraticCurveTo(0, -tablaLargo / 2 - 0.1, 0.32, -tablaLargo / 2 + 0.3);
+  contorno.lineTo(0.42, tablaLargo / 4);
+  contorno.quadraticCurveTo(0, tablaLargo / 2 + 0.3, -0.42, tablaLargo / 4);
+  contorno.closePath();
+  const tabla = new ExtrudeGeometry(contorno, { depth: 0.14, bevelEnabled: false, curveSegments: 4 });
+  tabla.rotateX(Math.PI / 2);
+  tabla.translate(0, 0.14, 0);
+  const cuerpo = new CapsuleGeometry(0.3, 0.8, 2, 6);
+  cuerpo.rotateX(0.25);
+  cuerpo.translate(0, 1, 0);
+  const cabeza = new SphereGeometry(0.28, 8, 6);
+  cabeza.translate(0, 1.95, 0.14);
+  const brazos = new BoxGeometry(0.16, 0.16, 1.7);
+  brazos.translate(0, 1.35, 0);
+  const piernas = new BoxGeometry(0.3, 0.5, 0.75);
+  piernas.translate(0, 0.35, 0);
+  return [
+    pieza(tabla, tablaColor, tinte),
+    pieza(cuerpo, "#1f2937"),
+    pieza(cabeza, "#e8b98f"),
+    pieza(brazos, "#1f2937"),
+    pieza(piernas, "#1f2937"),
