# Credenciales de tu aplicación en https://api.montevideo.gub.uy (Mis aplicaciones)
IM_CLIENT_ID=
IM_CLIENT_SECRET=
# Opcional: URL del token OAuth2 (por defecto la del manual de conexión de la IM)
# IM_TOKEN_URL=https://mvdapi-auth.montevideo.gub.uy/auth/realms/pci/protocol/openid-connect/token
# Credenciales de una segunda aplicación asociada al servicio "Transporte público"
IM_TRANSPORTE_CLIENT_ID=
IM_TRANSPORTE_CLIENT_SECRET=
# Supabase (me gusta de las playas). Dashboard → Project Settings → API Keys: URL y clave publicable
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo para `npm run errors` (leer/borrar la tabla de errores). Saltea RLS: nunca NEXT_PUBLIC_ ni en Vercel.
SUPABASE_SECRET_KEY=
# Google Analytics 4: ID de medición (G-XXXXXXX). Admin → Flujos de datos → Web. Sin ID no se carga
NEXT_PUBLIC_GA_ID=
# Mailgun (formulario de /contacto). Sin clave y dominio el formulario no se muestra
MAILGUN_API_KEY=
# Dominio de envío, p. ej. sandboxXXXX.mailgun.org
MAILGUN_DOMAIN=
# Opcional: "eu" si la cuenta está en la región europea
# MAILGUN_REGION=eu
# Opcional, solo para los checks (regla url-vitals): clave de la API de PageSpeed Insights (ver checks/README.md)
PSI_API_KEY=
